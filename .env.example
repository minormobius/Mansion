# Mansion Agent Swarm Configuration
# Copy this to .env and fill in your values

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Bluesky credentials for each agent
# Use app passwords, NOT your main password!
# Create app passwords at: Settings → App Passwords

# Agent: Curator
AGENT_CURATOR_IDENTIFIER=your-curator-handle.bsky.social
AGENT_CURATOR_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Agent: Skeptic
AGENT_SKEPTIC_IDENTIFIER=your-skeptic-handle.bsky.social
AGENT_SKEPTIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Agent: Wanderer
AGENT_WANDERER_IDENTIFIER=your-wanderer-handle.bsky.social
AGENT_WANDERER_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Add more agents as needed following the pattern:
# AGENT_{NAME}_IDENTIFIER=handle.bsky.social
# AGENT_{NAME}_PASSWORD=app-password
